# 本番はCloudflareのWorker変数・Secretに設定する。値をGitに入れない。
APP_ORIGIN=https://caravan.YOUR_DOMAIN
MTLS_MODE=required
MTLS_HOST=caravan.YOUR_DOMAIN
# 許可する証明書のSHA-256。複数の場合はカンマ区切り。
MTLS_ALLOWED_SHA256=
# AUTH_PEPPERとSETUP_TOKENは32バイト以上のランダム値。
AUTH_PEPPER=
SETUP_TOKEN=
# UNIX時間（ミリ秒）。初期設定リンクは生成から24時間。
SETUP_EXPIRES=
