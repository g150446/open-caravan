{
  "name": "open-caravan",
  "main": "build/worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "caravan.YOUR_DOMAIN", "custom_domain": true}],
  "triggers": {"crons": ["* * * * *"]},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-caravan-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://caravan.YOUR_DOMAIN",
    "MTLS_MODE": "required",
    "MTLS_HOST": "caravan.YOUR_DOMAIN",
    "MTLS_ALLOWED_SHA256": "REPLACE_WITH_CLIENT_CERTIFICATE_SHA256"
  },
  "observability": {
    "enabled": false
  }
}
